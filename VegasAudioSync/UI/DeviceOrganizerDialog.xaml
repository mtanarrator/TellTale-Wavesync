<Window x:Class="VegasAudioSync.UI.DeviceOrganizerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Organize Tracks by Device"
        Width="720" Height="520" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0E1015" Foreground="#E2E4E9"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceCard" Color="#1A1D27"/>
        <SolidColorBrush x:Key="SurfaceCardBorder" Color="#282C3D"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B92A5"/>
        <SolidColorBrush x:Key="TextBright" Color="#F4F5F8"/>

        <LinearGradientBrush x:Key="BrandCyanGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#0072FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Dark glass button, matching the main panel -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2230"/>
            <Setter Property="Foreground" Value="#D0D4E4"/>
            <Setter Property="BorderBrush" Value="#2F354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#292F42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#171A24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gradient action button, matching the main panel -->
        <Style x:Key="ModernHeroButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandCyanGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeroBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Small square checkbox used inside the Include column -->
        <Style x:Key="RowCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="#12141D" BorderBrush="#3A4058" BorderThickness="1">
                            <Path x:Name="Tick" Data="M 3.5,8.2 L 6.4,11 L 12.4,4.4"
                                  Stroke="#0E1015" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#00E5FF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#F4F5F8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless name editor inside a row -->
        <Style x:Key="CellTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F4F5F8"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditBorder" Property="BorderBrush" Value="#3E455E"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="EditBorder" Property="Background" Value="#12141D"/>
                                <Setter TargetName="EditBorder" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#12141D"/>
            <Setter Property="Foreground" Value="#A7AEC2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#1C202E" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="#A7AEC2" TextElement.FontSize="11" TextElement.FontWeight="Bold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E4E9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="#20242F" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1E2230"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#16333D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#2B5A68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom dark scrollbar, matching the panel -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#3A3F55"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + summary -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ORGANIZE TRACKS BY DEVICE" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBright}"/>
                <TextBlock Text="Paired video + audio tracks per camera, one audio track per recorder. Review inclusion and names before applying."
                           FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="TxtSummary" Grid.Column="1" Text=""
                       FontSize="11" Foreground="#A0A8BC"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="280"/>
        </Grid>

        <!-- Device list -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource SurfaceCardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="1">
            <ListView x:Name="LvGroups"
                      Background="Transparent" BorderThickness="0"
                      Foreground="#E2E4E9"
                      SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource DeviceRowStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="LvGroups_SelectionChanged"
                      TabIndex="1">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource DarkColumnHeader}">
                        <GridViewColumn Header="Include" Width="58">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource RowCheckBox}"
                                              IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Include this device when applying. Uncheck to leave it untouched."/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Name" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource CellTextBox}"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Track name for this device. Edit to rename the CAM/REC tracks."/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Type" Width="66">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindLabel}" Foreground="#D8DCE8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="72">
                            <GridViewColumn.Header>
                                <TextBlock Text="Role"
                                           ToolTip="Camera, Recorder, or B-roll (a camera group made only of clips shorter than 15 s). B-roll is informational and does not change track assignment."/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoleLabel}" Foreground="#A0A8BC" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="76">
                            <GridViewColumn.Header>
                                <TextBlock Text="Confidence"
                                           ToolTip="High = camera metadata (make/model) or camera model token. Medium = filename prefix + folder. Low = folder only."/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ConfidenceLabel}" Foreground="#A0A8BC" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Clips" Width="44">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ClipCount}" Foreground="#D8DCE8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="170">
                            <GridViewColumn.Header>
                                <TextBlock Text="Detected from"
                                           ToolTip="The evidence used to group these clips: camera metadata, filename prefix, folder, or a manual merge/split."/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Evidence}" Foreground="#8B92A5" Margin="6,0,4,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Evidence}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Row actions -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnMerge" Grid.Column="0" Content="Merge selected" Height="30" Margin="0,0,6,0"
                    Style="{StaticResource ModernSecondaryButton}" Click="BtnMerge_Click" TabIndex="2"
                    ToolTip="Combine the selected rows into the first selected row. Camera wins, events are unioned, evidence becomes 'merged'."/>
            <Button x:Name="BtnSplit" Grid.Column="1" Content="Split by folder" Height="30" Margin="0,0,6,0"
                    Style="{StaticResource ModernSecondaryButton}" Click="BtnSplit_Click" TabIndex="3"
                    ToolTip="Replace each selected row with one row per source folder."/>
            <Button x:Name="BtnSelectAll" Grid.Column="2" Content="Select all" Height="30" Margin="0,0,6,0"
                    Style="{StaticResource ModernSecondaryButton}" Click="BtnSelectAll_Click" TabIndex="4"
                    ToolTip="Include every device in the list."/>
            <Button x:Name="BtnSelectNone" Grid.Column="3" Content="Select none" Height="30"
                    Style="{StaticResource ModernSecondaryButton}" Click="BtnSelectNone_Click" TabIndex="5"
                    ToolTip="Exclude every device. Apply stays disabled until at least one is included."/>
        </Grid>

        <!-- Explanation + commit actions -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Nothing changes until Apply. Cameras keep their embedded audio; the whole pass is one Undo step."
                       VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,0,12,0"/>

            <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Width="92" Height="32"
                    Style="{StaticResource ModernSecondaryButton}" IsCancel="True" TabIndex="7"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnApply" Grid.Column="2" Content="Apply" Width="112" Height="32" Margin="8,0,0,0"
                    Style="{StaticResource ModernHeroButton}" IsDefault="True" TabIndex="8"
                    Click="BtnApply_Click"/>
        </Grid>
    </Grid>
</Window>
