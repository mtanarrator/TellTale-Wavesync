<UserControl x:Class="VegasAudioSync.UI.VegasAudioSyncControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="440"
             Background="#0E1015" Foreground="#E2E4E9" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!-- Modern Neon Gradient Palette -->
        <LinearGradientBrush x:Key="BrandCyanGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#0072FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SyncActiveGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#00F5A0" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SurfaceDark" Color="#151720"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#1A1D27"/>
        <SolidColorBrush x:Key="SurfaceCardBorder" Color="#282C3D"/>
        <SolidColorBrush x:Key="SurfaceCardBorderHover" Color="#3E455E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B92A5"/>
        <SolidColorBrush x:Key="TextBright" Color="#F4F5F8"/>

        <!-- Sleek Modern Studio Toggle Switch Template for CheckBox -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Pill Track -->
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="18" CornerRadius="9" Background="#242838" BorderBrush="#353A50" BorderThickness="1">
                                <!-- Switch Thumb -->
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#8B92A5" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0072FF"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Glass Button -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2230"/>
            <Setter Property="Foreground" Value="#D0D4E4"/>
            <Setter Property="BorderBrush" Value="#2F354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#292F42"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#171A24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Sync Button Style (Cyan -> Electric Blue Gradient) -->
        <Style x:Key="ModernHeroButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandCyanGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeroBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0072FF" ShadowDepth="2" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="HeroBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" Color="#00E5FF" ShadowDepth="2" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeroBorder" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="HeroBorder" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#3A3F55"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Brand Hero -->
            <RowDefinition Height="Auto"/> <!-- Waveform Graphic Banner -->
            <RowDefinition Height="Auto"/> <!-- Options Cards -->
            <RowDefinition Height="Auto"/> <!-- Master Track Selector -->
            <RowDefinition Height="*"/>    <!-- Terminal / HUD Output -->
            <RowDefinition Height="Auto"/> <!-- Status & Progress Bar -->
            <RowDefinition Height="Auto"/> <!-- Action Controls -->
        </Grid.RowDefinitions>

        <!-- 1. Header / Brand Hero -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vector Brand Emblem (Phase Alignment Icon) -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#161925" BorderBrush="#2C3248" BorderThickness="1" Margin="0,0,10,0">
                <Path Data="M 6,18 Q 11,8 16,18 T 26,18 T 30,18 M 6,21 Q 12,28 18,21 T 26,21"
                      Stroke="{StaticResource BrandCyanGradient}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TELLTALE" FontSize="11" FontWeight="Bold" Foreground="#8E95A5" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="WAVESYNC" FontSize="16" FontWeight="Black" VerticalAlignment="Bottom">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00E5FF" Offset="0"/>
                                <GradientStop Color="#0088FF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 2. Stylized Dual-Channel Audio Waveform Visualizer Banner -->
        <Border Grid.Row="1" Height="28" Background="#12141C" BorderBrush="#202434" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
            <Canvas>
                <!-- Subtle Grid lines -->
                <Line X1="0" Y1="14" X2="420" Y2="14" Stroke="#1E2232" StrokeThickness="1" StrokeDashArray="2,4"/>
                
                <!-- Master Wave (Cyan) -->
                <Path Data="M 0,14 Q 20,4 40,14 T 80,14 T 120,6 T 160,22 T 200,14 T 240,8 T 280,20 T 320,14 T 360,10 T 400,14" 
                      Stroke="#00E5FF" StrokeThickness="1.4" Opacity="0.75"/>
                
                <!-- Secondary Synchronized Wave (Electric Blue) -->
                <Path Data="M 0,14 Q 25,6 50,14 T 100,14 T 140,8 T 180,20 T 220,14 T 260,10 T 300,18 T 340,14 T 380,12 T 420,14" 
                      Stroke="#0072FF" StrokeThickness="1.2" Opacity="0.60"/>

                <!-- Phase Lock Crosshairs -->
                <Rectangle Canvas.Left="198" Canvas.Top="4" Width="4" Height="20" Fill="#00F5A0" Opacity="0.4" RadiusX="2" RadiusY="2"/>
            </Canvas>
        </Border>

        <!-- 3. Engine Options Card -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource SurfaceCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ENGINE PRECISION &amp; COMPENSATION" FontSize="9.5" FontWeight="Bold" Foreground="#6C758D" Margin="0,0,0,6"/>
                
                <CheckBox x:Name="ChkDetectDrift" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Clock Drift Correction" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="RANSAC linear regression &amp; dynamic PPM audio resampling" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkSubSample" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Sub-Sample Super-Resolution" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="Parabolic peak interpolation to fractional sample accuracy" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkDiscontinuity" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Dropped-Frame Auto-Slicing" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="Splits timeline events at VFR camera drop discontinuities" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkVoiceActivity" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Voice Activity Noise Gate" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="Attenuates quiet room ambience below -40 dB before matching" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkSelectedOnly" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Scope: Selected Takes &amp; Tracks Only" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="Syncs only highlighted timeline events; uncheck to sync entire project" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkIncludeVideo" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Include Video Clip Audio (Multicam)" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="Aligns camera clips using their embedded scratch audio" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkPreventCrossfades" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Prevent Crossfades (Auto-Add Tracks)" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="Spreads overlapping synced events onto extra video/audio lanes" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>

                <Separator Background="#222634" Margin="0,3"/>

                <CheckBox x:Name="ChkPreserveOrder" Style="{StaticResource ModernToggleSwitch}" IsChecked="False">
                    <StackPanel>
                        <TextBlock Text="Sync in Place (Lock Order)" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                        <TextBlock Text="One rigid shift per source; never reorders events or adds tracks" FontSize="10" Foreground="#8B92A5"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- 4. Master Reference Track Selector -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource SurfaceCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Master Anchor:" FontWeight="SemiBold" Foreground="#E2E4E9"/>
                    <TextBlock Text="Auto, or pick any audio/video track" FontSize="10" Foreground="#8B92A5"/>
                </StackPanel>

                <ComboBox x:Name="CmbMasterTrack" Grid.Column="1" 
                          Height="30" VerticalContentAlignment="Center"
                          Background="#12141D" Foreground="#000000" BorderBrush="#2F354A" 
                          Cursor="Hand" ToolTip="Choose the recorder or camera track you trust as the reference, or use Auto-Detect (longest continuous take). The engine uses the longest take on the selected track.">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#000000"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="Auto-Detect (Optimal Connectivity Anchor)" IsSelected="True" Foreground="#000000"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 5. Results / Log Terminal HUD -->
        <Border Grid.Row="4" Background="#0A0B10" BorderBrush="#222636" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Terminal Header Bar -->
                <Border Grid.Row="0" Background="#12141D" BorderBrush="#1C202E" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="10,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#FF5F56" Margin="0,0,5,0"/>
                            <Ellipse Width="8" Height="8" Fill="#FFBD2E" Margin="0,0,5,0"/>
                            <Ellipse Width="8" Height="8" Fill="#27C93F" Margin="0,0,8,0"/>
                            <TextBlock Text="ACTIVITY TERMINAL &amp; TIMELINE HUD" FontSize="9.5" FontWeight="Bold" Foreground="#6C758D"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Monospace Log Stream -->
                <ScrollViewer x:Name="LogScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                    <TextBlock x:Name="TxtLog" Text="Ready. Click 'Synchronize Timeline' to analyze and align multi-track audio." 
                               Foreground="#8892A8" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" LineHeight="17"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 6. Progress Section -->
        <Border Grid.Row="5" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" FontWeight="Medium" Foreground="#9BA3B8"/>
                </Grid>
                <Border Height="6" CornerRadius="3" Background="#161924" ClipToBounds="True">
                    <ProgressBar x:Name="PrgSync" Height="6" Minimum="0" Maximum="100" Value="0" 
                                 Background="Transparent" Foreground="{StaticResource SyncActiveGradient}" BorderThickness="0"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 7. Action Button Controls -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnRefresh" Grid.Column="0" Content="↺ Refresh" Height="36" Style="{StaticResource ModernSecondaryButton}" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnSync" Grid.Column="2" Content="⚡ Synchronize Timeline" Height="36" Style="{StaticResource ModernHeroButton}" Click="BtnSync_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="4" Content="■ Stop" Height="36" Style="{StaticResource ModernSecondaryButton}" Click="BtnCancel_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>
