<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="TellTale WaveSync"
           Manufacturer="TellTale FX"
           Version="1.3.3.0"
           UpgradeCode="D37E6081-3E2A-4D78-9B90-1DEB0703C14F"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="TellTale WaveSync - Audio &amp; Multi-Cam Synchronizer for VEGAS Pro (https://www.telltale.video)"
                        Manufacturer="TellTale FX" />

    <Property Id="ARPURLINFOABOUT" Value="https://www.telltale.video" />
    <Property Id="ARPURLUPDATEINFO" Value="https://www.telltale.video" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of TellTale WaveSync is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Remove any previous Inno Setup installation and registry entries of WaveSync -->
    <CustomAction Id="RemoveLegacyInnoWaveSync"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command &quot;$keys = @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{D37E6081-3E2A-4D78-9B90-1DEB0703C14F}_is1','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\{D37E6081-3E2A-4D78-9B90-1DEB0703C14F}_is1','HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{D37E6081-3E2A-4D78-9B90-1DEB0703C14F}_is1'); foreach ($k in $keys) { if (Test-Path $k) { $u = (Get-ItemProperty $k -ErrorAction SilentlyContinue).UninstallString; if ($u) { $exe = $u.Trim('\&quot;'); if (Test-Path $exe) { Start-Process -FilePath $exe -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait -WindowStyle Hidden } }; Remove-Item $k -Recurse -Force -ErrorAction SilentlyContinue } }&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveLegacyInnoWaveSync" Before="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VegasProDir" Name="Vegas Pro">
        <Directory Id="VegasVerDir" Name="2027.0">
          <Directory Id="INSTALLFOLDER" Name="Application Extensions">
            <Component Id="WaveSyncCoreBinaries" Guid="B8A4E110-4D3A-4F8B-9A2D-1E7C5D6A0001">
              <File Id="TellTaleWaveSyncDll"
                    Source="..\VegasAudioSync\bin\Release\net48\TellTaleWaveSync.dll"
                    KeyPath="yes" />
              <File Id="VegasSyncCoreDll"
                    Source="..\telltale_sync_core\target\release\telltale_sync_core.dll" />
              <RemoveFile Id="RemoveLegacyVegasAudioSyncDll" Name="VegasAudioSync.dll" On="both" />
              <RemoveFile Id="RemoveLegacyVegasAudioSyncOld" Name="VegasAudioSync.dll.old" On="both" />
              <RemoveFile Id="RemoveLegacyVegasSyncCoreDll" Name="vegas_sync_core.dll" On="both" />
            </Component>

            <Directory Id="DocFolder" Name="Documentation">
              <Component Id="WaveSyncDocs" Guid="B8A4E110-4D3A-4F8B-9A2D-1E7C5D6A0002">
                <File Id="PresentationHtml"
                      Source="..\TellTale_WaveSync_Presentation.html"
                      KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="TellTale WaveSync" Level="1">
      <ComponentRef Id="WaveSyncCoreBinaries" />
      <ComponentRef Id="WaveSyncDocs" />
    </Feature>
  </Package>
</Wix>
