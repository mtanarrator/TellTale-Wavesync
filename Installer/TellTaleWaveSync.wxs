<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="TellTale WaveSync"
           Manufacturer="TellTale FX"
           Version="2.0.0.0"
           UpgradeCode="D37E6081-3E2A-4D78-9B90-1DEB0703C14F"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="TellTale WaveSync - Audio &amp; Multi-Cam Synchronizer for VEGAS Pro"
                        Manufacturer="TellTale FX" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of TellTale WaveSync is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Remove any previous Inno Setup installation and registry entries of WaveSync.
         Only HKLM hives are probed: this custom action runs deferred with
         Impersonate="no" (LocalSystem), so a HKCU path would resolve to the SYSTEM
         profile's hive and never match the interactive user's Inno uninstall key.
         Per-user Inno installs are therefore not auto-removed; uninstall them manually. -->
    <CustomAction Id="RemoveLegacyInnoWaveSync"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command &quot;$keys = @('HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{D37E6081-3E2A-4D78-9B90-1DEB0703C14F}_is1','HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\{D37E6081-3E2A-4D78-9B90-1DEB0703C14F}_is1'); foreach ($k in $keys) { if (Test-Path $k) { $u = (Get-ItemProperty $k -ErrorAction SilentlyContinue).UninstallString; if ($u) { $exe = $u.Trim('\&quot;'); if (Test-Path $exe) { Start-Process -FilePath $exe -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait -WindowStyle Hidden } }; Remove-Item $k -Recurse -Force -ErrorAction SilentlyContinue } }&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveLegacyInnoWaveSync" Before="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- Install target: only the newest VEGAS Pro layout (BorisFX-era 2027.x under
         %ProgramData%\Vegas Pro\<version>\Application Extensions).
         Older MAGIX-era versions (22.0, 21.0, 20.0, 19.0 under %ProgramData%\VEGAS Pro)
         are intentionally NOT installed by this MSI: their existence can only be detected
         with an extension-based directory search (util:DirectorySearch / AppSearch), and a
         static <Directory> per version would create the folder and drop the DLLs into
         versions the user does not own. Use the Inno Setup installer
         (TellTaleWaveSync_Installer.iss) for multi-version deployment - its "allvegas"
         task enumerates the installed version folders at runtime.
         TODO(wix-multi-version): add per-version components (new GUIDs) once a reliable
         per-version existence test is available. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="VegasProDir" Name="Vegas Pro">
        <Directory Id="VegasVerDir" Name="2027.0">
          <Directory Id="INSTALLFOLDER" Name="Application Extensions">
            <Component Id="WaveSyncCoreBinaries" Guid="B8A4E110-4D3A-4F8B-9A2D-1E7C5D6A0001">
              <File Id="TellTaleAudiosyncDll"
                    Source="..\VegasAudioSync\bin\Release\net48\TellTale_Audiosync.dll"
                    KeyPath="yes" />
              <File Id="TelltaleSyncCoreDll"
                    Source="..\vegas_sync_core\target\release\telltale_sync_core.dll" />
              <RemoveFile Id="RemoveLegacyVegasAudioSyncDll" Name="VegasAudioSync.dll" On="both" />
              <RemoveFile Id="RemoveLegacyVegasAudioSyncOld" Name="VegasAudioSync.dll.old" On="both" />
              <RemoveFile Id="RemoveLegacyTellTaleWaveSyncDll" Name="TellTaleWaveSync.dll" On="both" />
              <RemoveFile Id="RemoveLegacyTellTaleWaveSyncStale" Name="TellTaleWaveSync.dll.stale" On="both" />
              <RemoveFile Id="RemoveLegacyTellTaleWaveSyncPdb" Name="TellTaleWaveSync.pdb" On="both" />
              <RemoveFile Id="RemoveLegacyVegasSyncCoreDll" Name="vegas_sync_core.dll" On="both" />
              <RemoveFile Id="RemoveLegacyVegasSyncCorePdb" Name="vegas_sync_core.pdb" On="both" />
            </Component>

            <Directory Id="DocFolder" Name="Documentation">
              <Component Id="WaveSyncDocs" Guid="B8A4E110-4D3A-4F8B-9A2D-1E7C5D6A0002">
                <File Id="PresentationHtml"
                      Source="..\TellTale_WaveSync_Presentation.html"
                      KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="TellTale WaveSync" Level="1">
      <ComponentRef Id="WaveSyncCoreBinaries" />
      <ComponentRef Id="WaveSyncDocs" />
    </Feature>
  </Package>
</Wix>
